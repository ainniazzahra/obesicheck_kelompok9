# Opsional; semua punya nilai default. Salin ke .env bila ingin mengubah.
# OBESICHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OBESICHECK_MODEL_PATH=../ml/models/ObesiCheckPredictor
# OBESICHECK_RESULTS_DIR=../ml/results
# OBESICHECK_DB_PATH=./database/obesicheck.db
# Kunci tanda tangan token (>=32 karakter). Bila kosong, kunci acak dibuat otomatis di backend/database/secret.key.
# OBESICHECK_SECRET_KEY=
# OBESICHECK_TOKEN_TTL_MINUTES=720
